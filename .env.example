# Copy to .env and replace every CHANGE_ME value. scripts/setup.ps1 generates these for you.
MYSQL_DATABASE=partsbox
MYSQL_USER=partsbox
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
DATABASE_URL=mysql+pymysql://partsbox:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:3307/partsbox?charset=utf8mb4
SECRET_KEY=CHANGE_ME_RANDOM_64_CHAR_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
APP_PORT=8000
# For an HTTPS reverse proxy, also set COOKIE_SECURE=true and your exact origin:
# TRUSTED_ORIGINS=["https://parts.example.com"]
